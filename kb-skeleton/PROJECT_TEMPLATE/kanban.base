filters:
  and:
    - file.inFolder("__PROJECT_SLUG__/issues")
    - '!file.inFolder("__PROJECT_SLUG__/issues/archive")'
views:
  - type: kanban
    name: __PROJECT_LABEL__ Board
    groupBy:
      property: status
      direction: DESC
    order:
      - area
      - priority
      - assignee
      - reported
      - tags
    sort:
      - property: priority
        direction: DESC
    boardColumns:
      - backlog
      - todo
      - in-progress
      - blocked
      - done
      - wont-fix
      - deferred
      - (No value)
